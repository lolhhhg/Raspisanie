<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/planner_widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_modern" android:orientation="vertical" android:padding="16dp">
 <TextView android:id="@+id/planner_widget_week" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#C9C8FF" android:textSize="11sp" android:textStyle="bold"/>
 <TextView android:id="@+id/planner_widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
 <TextView android:id="@+id/planner_widget_text" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:textColor="#FFFFFF" android:textSize="15sp" android:maxLines="8" android:ellipsize="end"/>
 <Chronometer android:id="@+id/planner_widget_timer" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFD4BE" android:textSize="18sp"/>
</LinearLayout>
